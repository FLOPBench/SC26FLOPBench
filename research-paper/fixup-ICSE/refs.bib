}

@article{chenggangluREMORAResourceMonitor2023,
	title = {{REMORA} {Resource} {Monitor}: {Usability}, {Performance} and {User} {Interface} {Improvements}},
	doi = {10.1145/3624062.3624141},
	abstract = {As modern HPC systems grow in complexity, assessing the performance of an application in a user’s job may require collecting metrics about various system components, such as processors, memory, file systems, and the network. Although monitoring tools exist for system administrators and managers to collect such information, end users often have limited access to the system monitor of choice, or the user may be overloaded with interface access and performance metric selection. For novices and non-HPC experts, Remora (REsource Monitoring for Remote Applications) provides simple tools that allow quick diagnostic assessments of their jobs, and flexible tools that are adaptable to various types of workflow.},
	author = {{Chenggang Lu} and {Kent Milfeld}},
