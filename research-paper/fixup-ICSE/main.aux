\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-A}}RQ1: Can LLMs Classify the Roofline Regime From Static Artifacts?}{6}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Per-precision performance on the 732-sample shared subset. For each precision we report MdAPE (median absolute percent error on nonzero RAI\xspace  ), BAcc (balanced accuracy on nonzero \textsc  {BB}\xspace  /\textsc  {CB}\xspace  ), and nonzero \textsc  {CB}\xspace  precision/recall/F1; the last two columns give median per-query cost (\$) and wall-clock time (s). A dash marks an undefined value (no predicted \textsc  {CB}\xspace  kernels, hence a zero denominator), as every model shows for SO FP16.}}{7}{table.4}\protected@file@percent }
\newlabel{tab:compute-bound-prf}{{IV}{7}{Per-precision performance on the 732-sample shared subset. For each precision we report MdAPE (median absolute percent error on nonzero \rai ), BAcc (balanced accuracy on nonzero \bandwidthbound /\computebound ), and nonzero \computebound precision/recall/F1; the last two columns give median per-query cost (\$) and wall-clock time (s). A dash marks an undefined value (no predicted \computebound kernels, hence a zero denominator), as every model shows for SO FP16}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}RQ2: What Does Cross-Compiled SASS Add, and Why?}{7}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Absolute percent error on nonzero RAI\xspace  cases, by model, precision, and evidence setting. The distribution has both a useful low-error region and a long failure tail. \textit  {source+SASS}\xspace  sharply expands the low-error FP16 region for the frontier models and tightens many FP32/FP64 distributions, mirroring the classification gains.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:nonzero-ape}{{4}{7}{Absolute percent error on nonzero \rai cases, by model, precision, and evidence setting. The distribution has both a useful low-error region and a long failure tail. \sourcesass sharply expands the low-error FP16 region for the frontier models and tightens many FP32/FP64 distributions, mirroring the classification gains}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Cliff's $\delta $ between feature-present and feature-absent nonzero RAI\xspace  error distributions. Positive $\Rightarrow $ higher error when the feature is present.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:feature-error-association}{{V}{8}{Cliff's $\delta $ between feature-present and feature-absent nonzero \rai error distributions. Positive $\Rightarrow $ higher error when the feature is present}{table.5}{}}
