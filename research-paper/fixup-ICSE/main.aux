\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Nonzero compute-bound precision/recall/F1 on the 732-sample shared subset, with median per-query cost (\$) and wall-clock time (s) for each configuration. The precision/recall/F1 metrics complement the balanced-accuracy headline of \autoref {tab:shared-results-summary} by exposing whether a method reaches high recall by over-predicting the compute-bound side. A dash marks an undefined value: when a model predicts no compute-bound kernels for a precision (as every model does for \textit  {source-only}\xspace  FP16), recall is $0$ and precision/F1 have a zero denominator.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:compute-bound-prf}{{V}{8}{Nonzero compute-bound precision/recall/F1 on the 732-sample shared subset, with median per-query cost (\$) and wall-clock time (s) for each configuration. The precision/recall/F1 metrics complement the balanced-accuracy headline of \autoref {tab:shared-results-summary} by exposing whether a method reaches high recall by over-predicting the compute-bound side. A dash marks an undefined value: when a model predicts no compute-bound kernels for a precision (as every model does for \sourceonly FP16), recall is $0$ and precision/F1 have a zero denominator}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Absolute percent error on nonzero RAI\xspace  cases, by model, precision, and evidence setting. The distribution has both a useful low-error region and a long failure tail. \textit  {source+SASS}\xspace  sharply expands the low-error FP16 region for the frontier models and tightens many FP32/FP64 distributions, mirroring the classification gains.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:nonzero-ape}{{4}{8}{Absolute percent error on nonzero \rai cases, by model, precision, and evidence setting. The distribution has both a useful low-error region and a long failure tail. \sourcesass sharply expands the low-error FP16 region for the frontier models and tightens many FP32/FP64 distributions, mirroring the classification gains}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Cliff's $\delta $ between the feature-present and feature-absent nonzero RAI\xspace  error distributions, per model and evidence setting (SO~=~\textit  {source-only}\xspace  , S+S~=~\textit  {source+SASS}\xspace  ). Positive $\Rightarrow $ higher error when the feature is present.}}{8}{table.6}\protected@file@percent }
\newlabel{tab:feature-error-association}{{VI}{8}{Cliff's $\delta $ between the feature-present and feature-absent nonzero \rai error distributions, per model and evidence setting (SO~=~\sourceonly , S+S~=~\sourcesass ). Positive $\Rightarrow $ higher error when the feature is present}{table.6}{}}
