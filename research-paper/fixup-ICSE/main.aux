\newlabel{tab:illustrative-rows}{{X}{15}{Illustrative released samples used only for intuition, not as additional evaluation evidence. These examples show accurate numeric \rai predictions in regimes where the relevant computation and memory behavior are visible to the model}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Exploratory feature/error association heatmap from the released artifact. Positive Cliff's delta means higher absolute RAI\xspace  error when the feature is present. The strongest repeated error signals come from division, special math, reusable subexpressions, and loop-invariant floating-point work. A post-hoc Mann--Whitney/BH sanity check across the same 72 model$\times $prompt$\times $feature cells preserves repeated positive associations for division, common float subexpressions, special math, loop-invariant FLOPs, helper-function calls, RNG inputs, branching, preprocessor defines, and data-dependent branching; those features appear in 7--90\% of the 1{,}336 voted kernels. Because the feature labels are generated by an auxiliary LLM-voting pipeline, we treat this figure as descriptive rather than causal.}}{16}{figure.7}\protected@file@percent }
\newlabel{fig:feature-heatmap}{{7}{16}{Exploratory feature/error association heatmap from the released artifact. Positive Cliff's delta means higher absolute \rai error when the feature is present. The strongest repeated error signals come from division, special math, reusable subexpressions, and loop-invariant floating-point work. A post-hoc Mann--Whitney/BH sanity check across the same 72 model$\times $prompt$\times $feature cells preserves repeated positive associations for division, common float subexpressions, special math, loop-invariant FLOPs, helper-function calls, RNG inputs, branching, preprocessor defines, and data-dependent branching; those features appear in 7--90\% of the 1{,}336 voted kernels. Because the feature labels are generated by an auxiliary LLM-voting pipeline, we treat this figure as descriptive rather than causal}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XI}{\ignorespaces Repeated-query response variability on the repeat-trials panel. ``CV'' is the median coefficient of variation of predicted RAI\xspace  across repeats (lower is more consistent); ``Agr'' is the fraction of cells whose \textsc  {BB}\xspace  /\textsc  {CB}\xspace  call is unanimous across repeats. Computed at the main-paper decode settings.}}{16}{table.11}\protected@file@percent }
\newlabel{tab:repeated-query-variance}{{XI}{16}{Repeated-query response variability on the repeat-trials panel. ``CV'' is the median coefficient of variation of predicted \rai across repeats (lower is more consistent); ``Agr'' is the fraction of cells whose \bandwidthbound /\computebound call is unanimous across repeats. Computed at the main-paper decode settings}{table.11}{}}
