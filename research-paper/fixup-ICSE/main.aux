\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Absolute percent error on nonzero RAI\xspace  cases, stratified by GPU. The smaller-cache 3080/A10 settings are generally less stable than A100/H100, especially for source-level reasoning about FP32/FP64 DRAM-visible traffic.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:appendix-ape-by-gpu}{{5}{14}{Absolute percent error on nonzero \rai cases, stratified by GPU. The smaller-cache 3080/A10 settings are generally less stable than A100/H100, especially for source-level reasoning about FP32/FP64 DRAM-visible traffic}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Static reference baselines on the 732-sample shared subset. Context median is a grouped cross-validated runtime$\times $GPU baseline; lexical and mnemonic are deterministic heuristics; the learned baselines are five-fold grouped tree baselines grouped by program. For each precision, the slash-separated triple reports Task~A zero/nonzero balanced accuracy, Task~C nonzero \textsc  {BB}\xspace  /\textsc  {CB}\xspace  balanced accuracy, and Task~D three-way balanced accuracy. ``MedAPE'' is the median nonzero absolute percent error.}}{14}{table.8}\protected@file@percent }
\newlabel{tab:static-baselines}{{VIII}{14}{Static reference baselines on the 732-sample shared subset. Context median is a grouped cross-validated runtime$\times $GPU baseline; lexical and mnemonic are deterministic heuristics; the learned baselines are five-fold grouped tree baselines grouped by program. For each precision, the slash-separated triple reports Task~A zero/nonzero balanced accuracy, Task~C nonzero \bandwidthbound /\computebound balanced accuracy, and Task~D three-way balanced accuracy. ``MedAPE'' is the median nonzero absolute percent error}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces Seed sensitivity for the learned static baselines across five grouped-CV seeds. Each entry reports mean$\pm $std over seeds for Task~C balanced accuracy and nonzero MedAPE. The low spread shows that the static-baseline comparisons are not driven by an unusually favorable random seed.}}{14}{table.9}\protected@file@percent }
\newlabel{tab:seed-sensitivity}{{IX}{14}{Seed sensitivity for the learned static baselines across five grouped-CV seeds. Each entry reports mean$\pm $std over seeds for Task~C balanced accuracy and nonzero MedAPE. The low spread shows that the static-baseline comparisons are not driven by an unusually favorable random seed}{table.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Absolute percent error on nonzero RAI\xspace  cases, stratified by runtime. The runtime split is precision-sensitive rather than uniform: CUDA tends to be easier for FP16/FP32 triage, while FP64 remains mixed across CUDA and OpenMP.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:appendix-ape-by-runtime}{{6}{15}{Absolute percent error on nonzero \rai cases, stratified by runtime. The runtime split is precision-sensitive rather than uniform: CUDA tends to be easier for FP16/FP32 triage, while FP64 remains mixed across CUDA and OpenMP}{figure.6}{}}
